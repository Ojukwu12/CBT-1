PORT=3000
MONGO_URI=mongodb://localhost:27017/cbt_system
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
AI_ENABLED=true
AI_DAILY_LIMIT=50
AI_CACHE_HOURS=24
UNIVERSITY_ID=unizik

# JWT Authentication (Required)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=10
JWT_ISSUER=cbt-backend
JWT_AUDIENCE=cbt-client

# Paystack Payment Integration (Optional)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
WEBHOOK_ENFORCE_IP_CHECK=false

# Redis Caching (Optional - falls back to in-memory cache if omitted)
REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL_SECONDS=120
CACHE_METRICS_ENABLED=false
CACHE_METRICS_LOG_EVERY=500

# Brevo Email Integration (Optional but recommended)
BREVO_API_KEY=your_brevo_api_key_here

# Email Configuration
EMAIL_FROM=noreply@universitycbt.com
SUPPORT_EMAIL=support@universitycbt.com
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Base URL for API endpoints in email links (used in templates)
# This should be the public URL of your API server
# For development: http://localhost:3000
# For production: https://api.yourdomain.com
BASE_URL=http://localhost:3000

# Frontend & CORS Configuration (Important for Production)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EXAM_RESULT_DELAY_MINUTES=5

# AI Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Storage Configuration
STORAGE_PROVIDER=local
S3_BUCKET=your_s3_bucket_name
S3_REGION=your_s3_region
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

